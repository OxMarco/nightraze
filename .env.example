# Copy to .env and fill in before running docker-compose.prod.yml.
#   cp .env.example .env

# The public domain that resolves (DNS A/AAAA record) to your VPS.
DOMAIN=nightraze.example.com

# Email Let's Encrypt uses for expiry notices. Must be a real address.
ACME_EMAIL=you@example.com

# Who may put /embed inside an iframe, as a space-separated CSP source list.
# Leave EMPTY to use the CrazyGames regional domains baked into
# server/src/embedding.ts — set this only to add a portal or a staging host
# without a release. Everything other than /embed always refuses to be framed.
#   EMBED_FRAME_ANCESTORS="https://*.crazygames.com https://crazygames.com"
EMBED_FRAME_ANCESTORS=

# Server log threshold: fatal | error | warn | info | debug | trace | silent.
# Anything else falls back to info. Game events (joins, kicks, bans, lever
# moves) are info/warn, so info is the useful production floor; warn drops the
# routine ones and keeps only rejections and failures.
LOG_LEVEL=info

# Per-request HTTP logging ("incoming request" / "request completed"). Defaults
# to false in production because the 3s healthcheck would otherwise dominate the
# log. Set true briefly when debugging the proxy or the WS upgrade.
LOG_REQUESTS=false

# Maximum concurrent players admitted to the single authoritative room. Start
# conservatively on a shared-vCPU CX22 and raise this after an on-host load test.
MAX_PLAYERS=40

# Maximum simultaneous play sockets accepted from one source IP.
MAX_CONNS_PER_IP=8

# Temporary IP ban after repeated protocol abuse.
CHEAT_BAN_SECONDS=300

# Each repeat offense within the reset window multiplies the previous duration:
# 5 minutes, 50 minutes, 500 minutes, 5000 minutes, then the 7-day cap.
CHEAT_BAN_MULTIPLIER=10
CHEAT_BAN_MAX_SECONDS=604800

# After 30 days without another offense, that IP returns to the first ban level.
CHEAT_BAN_RESET_SECONDS=2592000

# SQLite file used for durable temporary bans. Compose mounts /data on a named
# volume, so active bans survive server container rebuilds and restarts.
BAN_DB_PATH=/data/ip-bans.sqlite

# First-party aggregate product metrics. The SQLite file shares the durable
# /data volume with bans. Set a long random token to enable GET /metrics; when
# empty, the read route does not exist. Query with header x-metrics-token.
METRICS_DB_PATH=/data/metrics.sqlite
METRICS_TOKEN=

# Optional two-letter country header added by a trusted geo-aware reverse
# proxy (for example cf-ipcountry). Leave empty with plain Traefik; timezone is
# then used as the coarse location and raw IP addresses are never stored.
GEO_COUNTRY_HEADER=

# Bots keep the arena population near this while humans are present (±2 of
# random drift; more humans = fewer bots). 0 disables bots entirely.
BOT_POP_TARGET=12

# Irreducible-glow curve (GDD §10 lever 1): how much light a dark lantern
# cannot shed, max(0, (sqrt(L) - 5) * G). Range 0..20; reference 6.
# Higher = leaders can hide less = stronger anti-snowball.
GLOW_G=6

# Set this to enable POST /tune, which moves levers live so a playtest can
# sweep them across one sitting (§15 Q2). Leave EMPTY in production: the route
# does not exist unless a token is configured.
#   curl -XPOST $HOST/tune -H "x-tune-token: $TUNE_TOKEN" \
#        -H 'content-type: application/json' -d '{"g":11}'
TUNE_TOKEN=
