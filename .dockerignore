# The build context is now the repository root (one image needs both
# workspaces), so keep the heavy and irrelevant parts out of it.
**/node_modules
**/dist
**/*.test.mjs
**/test
# ...except the server suite, which the `test` stage runs during deploy. These
# negations must stay below the patterns above; the last match wins, and the
# runtime stage never copies them in.
!server/test
!server/test/**
!server/integration.test.mjs
.git
.github
.claude
.DS_Store
.env
.env.*
scripts
docker-compose*.yml
Makefile
*.md
