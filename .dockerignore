# The build context is now the repository root (one image needs both
# workspaces), so keep the heavy and irrelevant parts out of it.
**/node_modules
**/dist
**/*.test.mjs
**/test
# ...except the suites the `test` and `client-test` stages run during deploy.
# These negations must stay below the patterns above; the last match wins, and
# the runtime stage never copies them in.
!server/test
!server/test/**
!server/integration.test.mjs
!client/test
!client/test/**
.git
.github
.claude
**/.DS_Store
.env
.env.*
scripts
docker-compose*.yml
Makefile
*.md

# The CrazyGames build. It is uploaded to their CDN, never served by this
# server, so it has no business in the runtime image or in the build context
# that produces it.
crazygame
